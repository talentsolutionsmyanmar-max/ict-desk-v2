# Server only. Never use NEXT_PUBLIC_ for these values.
TYPESAFE_API_KEY=
# Separate random 64-character lowercase hexadecimal token for manual AI access.
# Never reuse your TypeSafe credential as the desk token.
JEV_DESK_TOKEN=

# Dedicated trading-desk Postgres database; server-only. Never use an unrelated app's database.
DATABASE_URL=
# Random scheduler secret; server-only. Required before enabling minute recording.
CRON_SECRET=
